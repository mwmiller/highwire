{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HighWire",
  "version": "0.21.0",
  "identifier": "net.zebrine.highwire",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:24042",
    "beforeBuildCommand": "",
    "frontendDist": "http://localhost:24042"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HighWire",
        "url": "http://localhost:24042",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/highwire-backend"],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {}
}
