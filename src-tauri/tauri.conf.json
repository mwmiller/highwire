{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HighWire",
  "version": "1.12.6",
  "identifier": "net.zebrine.highwire",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:24042",
    "beforeBuildCommand": "",
    "frontendDist": "http://localhost:24042"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HighWire",
