  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mwmiller/highwire/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDRDE3NkIxMjNEMzI2MEUKUldRT0p0TWpzWGJSdk1aYWdTRmtwSUFUakhjS0J2WVNjclRRK0hTZldUMFRQOWNnVFJaZHFvQW4K"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/highwire-backend"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
